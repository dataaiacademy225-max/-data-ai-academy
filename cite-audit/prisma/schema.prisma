// Schéma CITE Audit — socle MVP.
// Voir docs/ARCHITECTURE.md §3 pour la justification des choix.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────────

enum AuditStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELED
}

enum Pillar {
  CLARIFIER
  INDEXER
  TUNNEL
  ENCLENCHER
  GEO
}

enum Priority {
  CRITIQUE
  IMPORTANT
  RECOMMANDE
}

enum AiProviderKind {
  OPENAI_COMPATIBLE
  PERPLEXITY
  ANTHROPIC
  GEMINI
}

// ─── Authentification (tables attendues par Better Auth) ─────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // haché par Better Auth, jamais en clair
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Domaine CITE Audit ──────────────────────────────────────────

model Project {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  siteUrl             String // URL normalisée https://…
  domain              String // hôte, périmètre du futur crawl
  sector              String
  country             String // ISO 3166-1 alpha-2
  city                String?
  primaryTarget       String
  competitors         Json      @default("[]") // [{ name, url? }] validé par Zod
  geoQueries          String[]  @default([])
  ownershipAttestedAt DateTime
  // Données de démonstration : jamais créées depuis l'interface, uniquement par le seed.
  isDemo              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  audits              Audit[]
  aiRuns              AiVisibilityRun[]

  // Permet la clé étrangère composite Audit(projectId, isDemo) → Project(id, isDemo).
  // Permet les clés étrangères composites (projectId, isDemo) des audits et des lancements IA.
  @@unique([id, isDemo])
  @@index([userId, createdAt])
}

model Audit {
  id              String          @id @default(cuid())
  projectId       String
  // Toujours égal au isDemo du projet, garanti par la clé étrangère composite :
  // un audit réel ne peut pas être rattaché à un projet de démonstration, et inversement.
  isDemo          Boolean         @default(false)
  project         Project         @relation(fields: [projectId, isDemo], references: [id, isDemo], onDelete: Cascade, onUpdate: Cascade)
  status          AuditStatus     @default(QUEUED)
  scoringVersion  String
  attempts        Int             @default(0)
  lockedAt        DateTime? // posé par le worker à la prise en charge, renouvelé à chaque progression
  progress        Json? // { phase, pagesDone, pagesTotal } pour l'affichage pendant l'audit
  queuedAt        DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  // Résultats : null tant que l'audit n'a pas réellement été calculé.
  scoreTotal      Int?
  scoreClarifier  Float?
  scoreIndexer    Float?
  scoreTunnel     Float?
  scoreEnclencher Float?
  geoIndex        Int?
  coverage        Float?
  inputSnapshot   Json // copie des données du projet au lancement
  reportSnapshot  Json?
  errorCode       String?
  pages           PageAnalysis[]
  findings        Finding[]

  @@index([projectId, queuedAt])
  @@index([status, queuedAt])
}

model PageAnalysis {
  id            String   @id @default(cuid())
  auditId       String
  audit         Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requestedUrl  String
  finalUrl      String?
  httpStatus    Int?
  redirectChain Json     @default("[]") // [{ url, status }]
  pageType      String? // home | offer | about | contact | case-study | blog | faq | other
  robotsAllowed Boolean
  bytes         Int?
  fetchMs       Int?
  facts         Json? // faits observés (title, meta, h1…), jamais le HTML brut
  fetchError    String? // TIMEOUT | TOO_LARGE | BLOCKED_SSRF | ROBOTS_DISALLOWED | HTTP_ERROR | NOT_HTML
  analyzedAt    DateTime @default(now())

  @@index([auditId])
}

model Finding {
  id             String    @id @default(cuid())
  auditId        String
  audit          Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pillar         Pillar
  criterionCode  String
  priority       Priority
  observation    String // constat
  evidence       Json // preuves observées + URL(s) concernées
  impact         String // impact potentiel, formulation prudente
  recommendation String
  effort         String? // faible | moyen | élevé
  dismissedAt    DateTime? // marqué « faux positif » par l'utilisateur
  createdAt      DateTime  @default(now())

  @@index([auditId, priority])
}

enum AiQueryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Un lancement de mesure de visibilité IA : une série de requêtes envoyées à un fournisseur.
model AiVisibilityRun {
  id                  String          @id @default(cuid())
  projectId           String
  isDemo              Boolean         @default(false)
  project             Project         @relation(fields: [projectId, isDemo], references: [id, isDemo], onDelete: Cascade, onUpdate: Cascade)
  status              AuditStatus     @default(QUEUED)
  provider            AiProviderKind
  model               String // modèle demandé
  queryCount          Int
  estimatedCostMinUsd Float
  estimatedCostMaxUsd Float
  actualCostUsd       Float? // somme des coûts communiqués par l'API, si disponibles
  // file d'attente
  attempts            Int             @default(0)
  lockedAt            DateTime?
  queuedAt            DateTime        @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  progress            Json?
  errorCode           String?
  inputSnapshot       Json // marque, domaine, concurrents au moment du lancement
  results             AiQueryResult[]

  @@index([projectId, queuedAt])
  @@index([status, queuedAt])
}

/// Une requête envoyée à une IA et sa réponse, conservée sans modification.
model AiQueryResult {
  id                   String         @id @default(cuid())
  runId                String
  run                  AiVisibilityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position             Int // ordre dans le lancement
  query                String // requête originale, telle que saisie
  status               AiQueryStatus  @default(PENDING)
  attempts             Int            @default(0)
  provider             AiProviderKind
  requestedModel       String
  model                String? // identifiant renvoyé par l'API
  askedAt              DateTime?
  latencyMs            Int?
  rawResponse          String? // texte brut, jamais modifié
  rawPayload           Json? // réponse JSON complète, jamais modifiée
  sources              Json           @default("[]") // [{ url, title?, origin: API | TEXT }]
  brandDetected        String? // terme trouvé (nom, alias, domaine)
  brandMentioned       Boolean?
  brandCited           Boolean? // une source renvoyée pointe vers le site de la marque
  brandRecommended     Boolean? // formulation explicite de recommandation
  approxPosition       Int?
  positionRatio        Float?
  brandExcerpt         String?
  competitorsMentioned Json           @default("[]")
  confidence           Float?
  usage                Json?
  costUsd              Float?
  errorCode            String?
  errorMessage         String? // message nettoyé, sans clé ni en-tête
  httpStatus           Int?

  @@unique([runId, position])
  @@index([runId, status])
}

// ─── Limites anti-abus ───────────────────────────────────────────

/// Table attendue par Better Auth (rateLimit.storage = "database") pour ses routes HTTP /api/auth/*.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Limites des server actions (connexion, inscription, suppression de compte).
/// La clé est une empreinte SHA-256 : ni e-mail ni adresse IP en clair.
model ActionLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}
