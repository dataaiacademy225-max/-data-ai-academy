# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer .env.

# PostgreSQL (docker compose up -d fournit cette base en local)
DATABASE_URL="postgresql://cite:cite@localhost:5432/cite_audit"

# Base dédiée aux tests d'intégration (vidée à chaque lancement de tests)
TEST_DATABASE_URL="postgresql://cite:cite@localhost:5432/cite_audit_test"

# Better Auth — secret aléatoire d'au moins 32 caractères :  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Mot de passe du compte de démonstration créé par « pnpm db:seed » (min. 10 caractères)
DEMO_PASSWORD=""

# ─── Module facultatif de visibilité IA ───────────────────────────────
# Sans clé, le module est désactivé. La clé reste côté serveur (jamais en base, jamais dans le navigateur).
PERPLEXITY_API_KEY=""
# agent = Agent API (/v1/responses, recommandé depuis le retrait de Sonar Chat Completions) ; chat = ancien format
PERPLEXITY_API_MODE="agent"
# Adresse de l'API (https uniquement). À ne changer que pour un proxy ou un environnement de test.
# PERPLEXITY_BASE_URL="https://api.perplexity.ai"
# Limites (facultatif) : requêtes par lancement, par utilisateur et par 24 h, délai minimal entre deux appels
AI_MAX_QUERIES_PER_RUN=10
AI_MAX_QUERIES_PER_DAY=50
AI_MIN_INTERVAL_MS=1500
