# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer .env.

# PostgreSQL (docker compose up -d fournit cette base en local)
DATABASE_URL="postgresql://cite:cite@localhost:5432/cite_audit"

# Base dédiée aux tests d'intégration (vidée à chaque lancement de tests)
TEST_DATABASE_URL="postgresql://cite:cite@localhost:5432/cite_audit_test"

# Better Auth — secret aléatoire d'au moins 32 caractères :  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Mot de passe du compte de démonstration créé par « pnpm db:seed » (min. 10 caractères)
DEMO_PASSWORD=""

# ─── Module facultatif de visibilité IA ───────────────────────────────
# Sans clé, le module est désactivé. La clé reste côté serveur (jamais en base, jamais dans le navigateur).
PERPLEXITY_API_KEY=""
# agent = Agent API (/v1/responses, recommandé depuis le retrait de Sonar Chat Completions) ; chat = ancien format
PERPLEXITY_API_MODE="agent"
# Adresse de l'API (https uniquement). À ne changer que pour un proxy ou un environnement de test.
# PERPLEXITY_BASE_URL="https://api.perplexity.ai"
# Limites (facultatif) : requêtes par lancement, par utilisateur et par 24 h, délai minimal entre deux appels
AI_MAX_QUERIES_PER_RUN=10
AI_MAX_QUERIES_PER_DAY=50
AI_MIN_INTERVAL_MS=1500

# ─── Durées de conservation (purge automatique par le worker, une fois par jour) ───
# Sessions et jetons expirés : toujours supprimés. Le dernier audit et la dernière mesure IA de chaque projet sont toujours gardés.
# 0 (défaut) = historique gardé tant que le projet et le compte existent. Mettre par exemple 730 pour limiter à 2 ans.
AUDIT_RETENTION_DAYS=0
AI_RUN_RETENTION_DAYS=0

# ─── E-mails (confirmation d'adresse, mot de passe oublié) ───
# console = affichés dans le terminal (développement ; refusé en production, rien n'est envoyé)
# smtp    = envoi réel ; tous les prestataires courants (Brevo, Resend, Mailjet, OVH…) fournissent une URL SMTP
EMAIL_TRANSPORT="console"
# SMTP_URL="smtps://utilisateur:motdepasse@smtp.exemple.com:465"
# EMAIL_FROM="CITE Audit <no-reply@votre-domaine.com>"
# Comptes inactifs : e-mail d'avertissement après N jours sans connexion (1095 = 3 ans ; 0 = jamais),
# puis suppression du compte et de toutes ses données si aucune reconnexion pendant le délai (30 jours, minimum 14).
INACTIVE_ACCOUNT_DAYS=1095
INACTIVE_ACCOUNT_GRACE_DAYS=30
